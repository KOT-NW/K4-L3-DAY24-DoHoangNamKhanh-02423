# Required — API key for the OpenAI-compatible provider (OpenAI, DeepSeek, OpenCode Go...)
OPENAI_API_KEY=

# Endpoint. Leave empty for OpenAI. OpenCode Go example shown.
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# LangChain / NeMo Guardrails read this name instead of OPENAI_BASE_URL.
OPENAI_API_BASE=https://opencode.ai/zen/go/v1
# Stable routing session header required by OpenCode Go.
OPENAI_SESSION_ID=lab24-day24

# --- Models ---
# Generation + judge. Muse Spark 1.3 is only served on the Responses API.
GENERATION_MODEL=muse-spark-1.3-contributor
GENERATION_API_STYLE=responses
JUDGE_MODEL=muse-spark-1.3-contributor
JUDGE_API_STYLE=responses

# NeMo Guardrails provider only speaks /chat/completions.
GUARD_MODEL=mimo-v2.6-flash

# RAG pipeline (enrichment + RAGAS judge) needs a chat/completions model.
ENRICH_MODEL=deepseek-v4.1-flash
RAGAS_LLM_MODEL=deepseek-v4.1-flash
# Skip LLM enrichment during indexing to save API cost.
LAB24_SKIP_ENRICH=1

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
